# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development
PORT=5000

# ============================================================================
# DATABASE CONFIGURATION - Use individual vars (NOT connection string)
# ============================================================================
DB_NAME=skill_connect_db
DB_USER=admin
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# MINIO CONFIGURATION (OBJECT STORAGE) - Docker
# ============================================================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=skill-connect-bucket
MINIO_API_URL=http://minio:9000

# For local development, change MINIO_ENDPOINT to localhost

# ============================================================================
# EMAIL CONFIGURATION - MAILPIT (LOCAL TESTING) - Docker
# ============================================================================
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
MAILPIT_API_URL=http://mailpit:8025
EMAIL_FROM=noreply@skillconnect.com
EMAIL_USER=test@skillconnect.com
EMAIL_PASS=test

# For local development, change MAILPIT_HOST to localhost

# ============================================================================
# EMAIL CONFIGURATION - SENDPULSE (PRODUCTION)
# ============================================================================
SENDPULSE_HOST=smtp.sendpulse.com
SENDPULSE_PORT=587
SENDPULSE_USER=your_sendpulse_email@example.com
SENDPULSE_PASS=your_sendpulse_password
SENDPULSE_MAX_USERS=300
SENDPULSE_MAX_EMAILS=12000

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
ADMIN_EMAIL=admin@skillconnect.com
ADMIN_PASSWORD=admin123

# ============================================================================
# JWT & SECURITY
# ============================================================================
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRY=24h

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_URL=http://localhost:3000
