# ============================================================================
# FRONTEND API CONFIGURATION
# ============================================================================

# IMPORTANT: For browser/Windows access from localhost:3000
# Use localhost:5000, NOT the Docker container name "backend"
# The browser on your Windows PC cannot resolve "backend" - it needs "localhost"
REACT_APP_API_URL=http://localhost:5000

# Application environment
REACT_APP_ENV=development

# Optional: Set to false to disable debug logging
REACT_APP_DEBUG=true
